{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget-form.html.twig' %}

{% block buy_widget_buy_container %}
    {{ parent() }}
        {% block buy_widget_inquiry_form %}
            {% set dasformMaster = config('SvenDasForm.config.show') %}

            {# Resolved server-side by ProductPageSubscriber, including the values
               inherited from the main product of a variant. #}
            {% set dasformConfig = page.extensions.dasForm %}

            {# Built with `if` rather than a `for` loop on purpose: a `set` inside
               a Twig for loop is scoped to that loop and would be lost here. #}
            {% set dasformButtons = [] %}
            {% set dasformRadius = dasformConfig ? dasformConfig.radius : '' %}
            {% set dasformRates = dasformConfig ? dasformConfig.rates : [] %}

            {% if dasformMaster and dasformConfig %}
                {% if dasformConfig.inquiry and dasformConfig.inquiry.active %}
                    {% set dasformButtons = dasformButtons|merge([dasformConfig.inquiry|merge({
                        'type': 'inquiry',
                        'icon': 'envelope'
                    })]) %}
                {% endif %}

                {% if dasformConfig.financing and dasformConfig.financing.active %}
                    {% set dasformButtons = dasformButtons|merge([dasformConfig.financing|merge({
                        'type': 'financing',
                        'icon': 'euro'
                    })]) %}
                {% endif %}
            {% endif %}

            {% if dasformButtons is not empty %}
                <div class="dasform-buttons"
                     data-dasform-contact-inject
                     data-dasform-product-name="{{ page.product.translated.name }}">
                    {% for dasformButton in dasformButtons %}
                        {% set dasformModalUrl = path('frontend.cms.page', {
                            id: config('core.basicInformation.contactPage'),
                            productName: page.product.translated.name,
                            productId: page.product.id,
                            inquiryText: dasformButton.text,
                            inquirySubject: dasformButton.subject,
                            inquiryType: dasformButton.type
                        }) %}

                        {# The action carries the sales-channel prefix and the type,
                           so the controller knows which recipient to use even
                           without JavaScript. #}
                        {% set dasformAction = dasformButton.type == 'financing'
                            ? path('sven.dasform.inquiry.send', { type: 'financing' })
                            : path('sven.dasform.inquiry.send') %}

                        {% set dasformShowRates = dasformButton.type == 'financing' and dasformRates is not empty %}

                        {# Wrapper traegt die Flex-Breite, damit der Tooltip absolut dazu
                           positioniert werden kann, ohne die Button-Groesse anzufassen. #}
                        <div class="dasform-btn-wrap{{ dasformShowRates ? ' dasform-btn-wrap--rates' : '' }}">
                        <a href="{{ dasformModalUrl }}"
                           data-ajax-modal="true"
                           data-url="{{ dasformModalUrl }}"
                           {# btn-primary/btn-buy sind die Klassen des Kaufen-Buttons: Radius,
                              Groesse und Fokusring kommen damit aus dem Theme und passen zum
                              Nachbarn. Farbe und Anordnung ueberschreiben wir per a.dasform-btn. #}
                           class="btn btn-primary btn-buy dasform-btn dasform-btn--{{ dasformButton.type }}{{ dasformButton.type == 'inquiry' ? ' produktanfrage' : '' }}"
                           {# Der Radius steht bewusst inline und nur dann, wenn er konfiguriert
                              ist: so schlaegt er jede Theme-Regel, laesst aber im Normalfall
                              dem Theme den Vortritt. #}
                           style="--dasform-btn-color: {{ dasformButton.color }};{% if dasformRadius %} border-radius: {{ dasformRadius }};{% endif %}"
                           data-dasform-type="{{ dasformButton.type }}"
                           data-dasform-action="{{ dasformAction }}"
                           data-dasform-inquiry-text="{{ dasformButton.text }}"
                           data-dasform-inquiry-subject="{{ dasformButton.subject }}"
                           {% if dasformShowRates %}aria-describedby="dasform-rates"{% endif %}>
                            {# Ohne `size`: das Icon behaelt die Basisgroesse des Themes und
                               sitzt damit buendig zur Beschriftung. #}
                            {% sw_icon dasformButton.icon style { 'pack': 'default' } %}
                            <span class="dasform-btn__label">{{ dasformButton.label }}</span>
                        </a>

                        {% if dasformShowRates %}
                            {# Wird vom Storefront-Plugin an <body> gehaengt und per
                               position: fixed platziert — so kann kein Vorfahre mit
                               overflow: hidden den Tooltip abschneiden. #}
                            <div class="dasform-rates" id="dasform-rates" role="tooltip" data-dasform-rates>
                                <div class="dasform-rates__title">Mögliche Monatsraten</div>

                                {% for dasformRate in dasformRates %}
                                    <div class="dasform-rates__row">
                                        <span class="dasform-rates__name">{{ dasformRate.label }}</span>
                                        <span class="dasform-rates__price">
                                            {{ dasformRate.net|currency }}
                                            <span class="dasform-rates__gross">/ {{ dasformRate.gross|currency }} brutto</span>
                                        </span>
                                        <span class="dasform-rates__meta">
                                            {{ dasformRate.credit }} % Kaufanrechnung, Rückgabe ab Monat {{ dasformRate.returnFrom }}
                                        </span>
                                    </div>
                                {% endfor %}

                                <div class="dasform-rates__note">Unverbindlich, Details auf Anfrage.</div>
                            </div>
                        {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endblock %}
{% endblock %}
